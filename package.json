{
  "name": "multitracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,tsx,css}\" eslint.config.ts vite.config.ts",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,tsx,css}\" eslint.config.ts vite.config.ts",
    "lint": "eslint . --max-warnings 0 && npm run accessibility",
    "accessibility": "oxlint --config scripts/oxlint.json --disable-nested-config --max-warnings 0 .",
    "complexity": "eslint . --max-warnings 0 && find src -type f -name '*.css' -exec awk 'FNR > 300 { print FILENAME \": больше 300 строк\"; exit 1 }' {} +",
    "security": "npm run lint && env -u npm_config_allow_scripts -u NPM_CONFIG_ALLOW_SCRIPTS npm audit --audit-level=high",
    "secrets": "gitleaks dir . --redact --no-banner",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:gates": "node --experimental-strip-types scripts/check-gates.ts",
    "check": "npm run format:check && npm run typecheck && npm run typecheck:ts6 && npm run complexity && npm run test:gates && npm test && npm run build && npm run security && npm run secrets",
    "test:ui": "node --experimental-strip-types scripts/check-ui.ts",
    "test:ui:docker": "vite build --outDir dist && scripts/ui-docker.sh dist check-ui.ts",
    "test:ui:exhaust": "vite build --outDir dist/exhaust --emptyOutDir --sourcemap && scripts/exhaust-docker.sh dist/exhaust exhaust/run.ts",
    "exhaust:baseline": "node --experimental-strip-types scripts/exhaust/baseline.ts",
    "test:smoke": "node --experimental-strip-types scripts/ui-smoke.ts",
    "test:ui:matrix": "vite build --outDir dist/matrix --emptyOutDir && scripts/ui-docker.sh dist/matrix exhaust/matrix.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "overrides": {
    "eslint-plugin-functional": {
      "deepmerge-ts": "8.0.2"
    },
    "@typescript/typescript6": {
      "@typescript/old": "npm:typescript@6.0.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.1.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  }
}
